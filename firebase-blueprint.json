{
  "entities": {
    "UserProfile": {
      "title": "User Profile & Sync Metadata",
      "description": "Stores an authenticated user's AndrewsPlan sync summary and display preferences without storing plaintext credentials.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner."
        },
        "cloudplanUsername": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "AndrewsPlan username associated with the last sync."
        },
        "calendarName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Human-readable name of the synced ICS calendar."
        },
        "lastSyncedAt": {
          "type": "string",
          "format": "date-time",
          "minLength": 10,
          "maxLength": 64,
          "description": "ISO-8601 timestamp of the latest AndrewsPlan ICS sync."
        },
        "eventCount": {
          "type": "integer",
          "description": "Total number of normalized events synced."
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "description": "User's preferred UI theme."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": [
        "userId",
        "cloudplanUsername",
        "calendarName",
        "lastSyncedAt",
        "eventCount",
        "theme",
        "createdAt",
        "updatedAt"
      ]
    },
    "SyncedEvent": {
      "title": "Synced AndrewsPlan Event",
      "description": "Normalized ICS event snapshot persisted per user for cross-device agenda viewing.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner."
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sanitized deterministic document ID for this event occurrence."
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Original iCalendar VEVENT UID."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Event title/summary."
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "description": "Event description/notes."
        },
        "location": {
          "type": "string",
          "maxLength": 400,
          "description": "Event location."
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "minLength": 10,
          "maxLength": 64,
          "description": "ISO-8601 start timestamp."
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "minLength": 10,
          "maxLength": 64,
          "description": "ISO-8601 end timestamp."
        },
        "allDay": {
          "type": "boolean",
          "description": "True if the event spans a full calendar date."
        },
        "isRecurring": {
          "type": "boolean",
          "description": "True if derived from an RRULE recurrence."
        },
        "status": {
          "type": "string",
          "maxLength": 64,
          "description": "iCalendar STATUS value."
        },
        "organizer": {
          "type": "string",
          "maxLength": 240,
          "description": "Event organizer name or email."
        },
        "url": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional event URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when event document was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when event document was updated."
        }
      },
      "required": [
        "userId",
        "eventId",
        "uid",
        "summary",
        "description",
        "location",
        "start",
        "end",
        "allDay",
        "isRecurring",
        "status",
        "organizer",
        "url",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Per-user AndrewsPlan sync metadata and display preferences."
    },
    "/users/{userId}/events/{eventId}": {
      "schema": {
        "$ref": "#/entities/SyncedEvent"
      },
      "description": "User's synced AndrewsPlan ICS events."
    }
  }
}
